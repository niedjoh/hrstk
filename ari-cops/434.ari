; @cops 434
; http://www.cs.vu.nl/~femke/ps/examples.ps p. 13
(format HRS)
(sort nat)
(sort natlist)
(fun nil natlist)
(fun cons (-> nat natlist natlist))
(fun plus (-> nat nat nat))
(fun foldl (-> (-> nat nat nat) nat natlist nat))
(fun sum (-> natlist nat))
(fun 0 nat)
(rule (foldl F n nil) n)
(rule (foldl F n (cons h t)) (foldl F (F n h) t))
(rule (sum l) (foldl plus 0 l))