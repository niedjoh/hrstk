; @doi 10.1016/S0304-3975(98)00078-4
; @cops 429
; [83] Example 1 without rules for max and min
(format HRS)
(sort nat)
(sort natlist)
(fun 0 nat)
(fun s (-> nat nat))
(fun nil natlist)
(fun cons (-> nat natlist natlist))
(fun max (-> nat nat nat))
(fun min (-> nat nat nat))
(fun insert (-> nat natlist (-> nat nat nat) (-> nat nat nat) natlist))
(fun sort (-> natlist (-> nat nat nat) (-> nat nat nat) natlist))
(fun asort (-> natlist natlist))
(fun dsort (-> natlist natlist))
(rule (insert n nil F G) (cons n nil))
(rule (insert n (cons h t) F G) (cons (F n h) (insert (G n h) t F G)))
(rule (sort nil F G) nil)
(rule (sort (cons h t) F G) (insert h (sort t F G) F G))
(rule (asort l) (sort l min max))
(rule (dsort l) (sort l max min))