; @cops 517
; [127] p. 209 ignoring types
(format HRS)
(sort a)
(fun nil a)
(fun cons (-> a a a))
(fun foldr (-> (-> a a a) a a a))
(fun build (-> (-> (-> a a a) a a) a))
(fun add (-> a a a))
(fun 0 a)
(fun s (-> a a))
(fun sum (-> a a))
(fun down (-> a a))
(fun down' (-> a (-> a a a) a a))
(rule (foldr k z nil) z)
(rule (foldr k z (cons x xs)) (k x (foldr k z xs)))
(rule (build g) (g cons nil))
(rule (foldr k z (build g)) (g k z))
(rule (sum xs) (foldr add 0 xs))
(rule (down x) (build (down' x)))
(rule (down' 0 k z) z)
(rule (down' (s x) k z) (k x (down' x k z)))