; @cops 520
(format HRS)
(sort bool)
(sort string)
(fun nil string)
(fun 1 (-> string string))
(fun 0 (-> string string))
(fun true bool)
(fun false bool)
(fun not (-> bool bool))
(fun fold (-> (-> bool bool) (-> bool bool) bool string bool))
(rule (not true) false)
(rule (not false) true)
(rule (fold F G z nil) z)
(rule (fold F G z (0 y)) (fold F G (F z) y))
(rule (fold F G z (1 y)) (fold F G (G z) y))
(rule (0 (1 y)) (1 (0 y)))