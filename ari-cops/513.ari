; @cops 513
; adapted from [88]
(format HRS)
(sort T)
(sort F)
(fun not (-> F F))
(fun and (-> F F F))
(fun or (-> F F F))
(fun all (-> (-> T F) F))
(fun ex (-> (-> T F) F))
(rule (and P (all Q)) (all (lambda ((x T)) (and P (Q x)))))
(rule (and (all Q) P) (all (lambda ((x T)) (and (Q x) P))))
(rule (or P (all Q)) (all (lambda ((x T)) (or P (Q x)))))
(rule (or (all Q) P) (all (lambda ((x T)) (or (Q x) P))))
(rule (and P (ex Q)) (ex (lambda ((x T)) (and P (Q x)))))
(rule (and (ex Q) P) (ex (lambda ((x T)) (and (Q x) P))))
(rule (or P (ex Q)) (ex (lambda ((x T)) (or P (Q x)))))
(rule (or (ex Q) P) (ex (lambda ((x T)) (or (Q x) P))))
(rule (not (all Q)) (ex (lambda ((x T)) (not (Q x)))))
(rule (not (ex Q)) (all (lambda ((x T)) (not (Q x)))))
(rule (and P R) (and R P))
(rule (or P R) (or R P))