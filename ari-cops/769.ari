; @author Makoto Hamana
; @cops 769
; [82] Section 5.1.2.2
(format HRS)
(sort A)
(sort B)
(sort U)
(sort i)
(fun case (-> U (-> A i) (-> B i) i))
(fun inl (-> A U))
(fun inr (-> B U))
(rule (case (inl X) F G) (F X))
(rule (case (inr Y) F G) (G Y))
(rule (case Z (lambda ((x A)) (H (inl x))) (lambda ((y B)) (H (inr y)))) (H Z))