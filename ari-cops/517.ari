; @cops 517
; [127] p. 209 without rank 2 polymorphism
(format HRS)
(sort a)
(sort b)
(fun nil b)
(fun cons (-> a b b))
(fun foldr (-> (-> a b b) b b b))
(fun build (-> (-> (-> a b b) b b) b))
(rule (foldr k z nil) z)
(rule (foldr k z (cons x xs)) (k x (foldr k z xs)))
(rule (build g) (g cons nil))
(rule (foldr k z (build g)) (g k z))