; @author Makoto Hamana
; @doi 10.1007/11805618_13
; @cops 749
; [132] Section 3.2 with (com2) and (com4)
(format HRS)
(sort a)
(sort b)
(sort ab)
(sort BGa)
(sort BGb)
(sort BGc)
(sort BGaBGb)
(sort BGbBGc)
(fun abs (-> (-> a b) ab))
(fun app (-> ab a b))
(fun absBG (-> (-> BGa BGb) BGaBGb))
(fun appBGaBGb (-> BGaBGb BGa BGb))
(fun appBGbBGc (-> BGbBGc BGb BGc))
(fun banga (-> a BGa))
(fun let (-> BGa (-> a BGb) BGb))
(fun letbc (-> BGb (-> b BGc) BGc))
(fun letBGaBGb (-> BGa (-> a BGaBGb) BGaBGb))
(fun letac (-> BGa (-> a BGc) BGc))
(rule (app (abs M) N) (M N))
(rule (abs (lambda ((x a)) (app S x))) S)
(rule (appBGaBGb (absBG M1) N1) (M1 N1))
(rule (absBG (lambda ((x BGa)) (appBGaBGb S1 x))) S1)
(rule (let (banga N) Q) (Q N))
(rule (let L (lambda ((x a)) (C (banga x)))) (C L))
(rule (letbc (let L Q) K) (letac L (lambda ((x a)) (letbc (Q x) K))))
(rule (appBGbBGc S2 (let L Q)) (letac L (lambda ((x a)) (appBGbBGc S2 (Q x)))))

