; @author Julian Nagele
; @cops 725
; [85] p. 63
(format HRS)
(sort nat)
(sort natlist)
(fun 0 nat)
(fun s (-> nat nat))
(fun nil natlist)
(fun cons (-> nat natlist natlist))
(fun map (-> (-> nat nat) natlist natlist))
(fun op (-> (-> nat nat) (-> nat nat) nat nat))
(fun pow (-> (-> nat nat) nat nat nat))
(fun at (-> (-> nat nat) nat nat))
(fun L (-> (-> nat nat) nat nat))
(rule (map F nil) nil)
(rule (map F (cons h t)) (cons (at F h) (map F t)))
(rule (pow F 0 y) (L (lambda ((x nat)) x) y))
(rule (pow F (s z) y) (op F (pow F (s z)) y))
(rule (op F G y) (at F (at G y)))
(rule (L (at F) y) (F y))
(rule (L (op F G) y) (op F G y))
(rule (at F z) (F z))