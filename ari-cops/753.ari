; @author Makoto Hamana
; @doi 10.1007/3-540-58233-9_14
; @cops 753
; [134] Section 6.3 (variant)
(format HRS)
(sort A)
(sort B)
(sort C)
(sort SAB)
(fun case (-> SAB (-> A C) (-> B C) C))
(fun inl (-> A SAB))
(fun inr (-> B SAB))
(fun f A)
(fun a A)
(fun b A)
(rule (case (inl X) F G) (F X))
(rule (case (inr Y) F G) (G Y))
(rule (case Z (lambda ((x A)) (H (inl x))) (lambda ((y B)) (H (inr y)))) (H Z))
(rule f a)
(rule f b)