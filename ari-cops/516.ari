; @cops 516
; [127] p. 206 with rule for function composition
(format HRS)
(sort a)
(sort alist)
(fun nil alist)
(fun cons (-> a alist alist))
(fun map (-> (-> a a) alist alist))
(fun o (-> (-> a a) (-> a a) a a))
(rule (map f nil) nil)
(rule (map f (cons x xs)) (cons (f x) (map f xs)))
(rule (map f (map g xs)) (map (lambda ((z a)) (o f g z)) xs))
(rule (o f g y) (f (g y)))