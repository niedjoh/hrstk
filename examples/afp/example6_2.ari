(format higher-order)
(sort nat)
(sort list)
(fun 0 nat)
(fun s (-> nat nat))
(fun nil list)
(fun cons (-> nat list list))
(fun map (-> (-> nat nat) list list))
(fun f (-> list list))
(fun g (-> nat nat))
(rule (map (lambda ((x0 nat)) (Z x0)) nil) nil)
(rule (map (lambda ((x0 nat)) (Z x0)) (cons H T)) (cons (Z H) (map (lambda ((x0 nat)) (Z x0)) T)))
(rule (f L) (map (lambda ((x0 nat)) (g x0)) L))
(rule (g X) X)